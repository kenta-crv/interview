.db-v2-header
  .db-v2-header__left
    nav.db-v2-breadcrumb aria-label=t("meetia.dashboard.common.breadcrumb")
      = link_to dashboard_index_path, class: "db-v2-breadcrumb__link" do
        i.fa-solid.fa-gauge-high aria-hidden="true"
        span = t("meetia.dashboard.common.dashboard")
      i.fa-solid.fa-chevron-right.db-v2-breadcrumb__sep aria-hidden="true"
      = link_to t("meetia.dashboard.deals.manage"), dashboard_deals_path, class: "db-v2-breadcrumb__link"
      i.fa-solid.fa-chevron-right.db-v2-breadcrumb__sep aria-hidden="true"
      span.db-v2-breadcrumb__current = t("meetia.dashboard.deals.new_current")
    h1.db-v2-header__title = t("meetia.dashboard.deals.new_title")
  .db-v2-header__right
    = render "/dashboard/theme_switch"
    = link_to dashboard_deals_path, class: "db-v2-btn db-v2-btn--ghost" do
      i.fa-solid.fa-arrow-left aria-hidden="true"
      span = t("meetia.dashboard.deals.back_to_list")

.db-v2-bottom-card
  .db-v2-bottom-card__header
    h2.db-v2-bottom-card__title = t("meetia.dashboard.deals.basic_info")
  .db-v2-bottom-card__body
    = form_with model: @deal, url: dashboard_deals_path, local: true, method: :post do |f|
      - if @deal.errors.any?
        .db-v2-alert.db-v2-alert--danger
          ul
            - @deal.errors.full_messages.each do |message|
              li = message
      - unless acting_as_admin? && !client_signed_in?
        .db-v2-form-group
          = label_tag "deal_company", t("meetia.dashboard.deals.field_company"), class: "db-v2-form-label"
          = text_field_tag "deal[company]", @company_name, class: "db-v2-form-control", required: true, id: "deal_company", placeholder: t("meetia.dashboard.deals.field_company_ph"), autocomplete: "organization"
      .db-v2-form-group
        = f.label :title, t("meetia.dashboard.deals.field_title"), class: "db-v2-form-label"
        = f.text_field :title, class: "db-v2-form-control", required: true, placeholder: t("meetia.dashboard.deals.field_title_ph")
      .db-v2-form-group
        = f.label :description, t("meetia.dashboard.deals.field_description"), class: "db-v2-form-label"
        = f.text_area :description, class: "db-v2-form-control", rows: 4, placeholder: t("meetia.dashboard.deals.field_description_ph")
      .db-v2-form-group
        = f.label :language, t("meetia.dashboard.deals.field_language"), class: "db-v2-form-label"
        = f.select :language, Deal.languages.map { |k, v| [k.upcase, v] }, {}, class: "db-v2-form-control"
      .db-v2-form-group
        = f.label :tts_voice_gender, t("meetia.dashboard.deals.field_voice"), class: "db-v2-form-label"
        = f.select :tts_voice_gender, Deal::TTS_VOICE_GENDERS.keys.map { |k| [t("meetia.dashboard.voice.#{k}"), k] }, {}, class: "db-v2-form-control"
      .db-v2-form-actions
        = f.submit t("meetia.dashboard.deals.submit_create"), class: "db-v2-btn db-v2-btn--primary"
        = link_to dashboard_deals_path, class: "db-v2-btn db-v2-btn--ghost" do
          span = t("meetia.dashboard.common.cancel")
