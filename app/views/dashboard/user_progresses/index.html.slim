.db-v2-header
  .db-v2-header__left
    nav.db-v2-breadcrumb aria-label=t("meetia.dashboard.common.breadcrumb")
      = link_to dashboard_index_path, class: "db-v2-breadcrumb__link" do
        i.fa-solid.fa-gauge-high aria-hidden="true"
        span = t("meetia.dashboard.common.dashboard")
      i.fa-solid.fa-chevron-right.db-v2-breadcrumb__sep aria-hidden="true"
      = link_to @deal.title.truncate(28), dashboard_deal_path(@deal), class: "db-v2-breadcrumb__link"
      i.fa-solid.fa-chevron-right.db-v2-breadcrumb__sep aria-hidden="true"
      span.db-v2-breadcrumb__current = t("meetia.dashboard.leads.title")
    h1.db-v2-header__title = t("meetia.dashboard.leads.title")
    p.db-v2-header__subtitle = @deal.title
  .db-v2-header__right
    = render "/dashboard/theme_switch"
    = link_to dashboard_deal_path(@deal), class: "db-v2-btn db-v2-btn--ghost" do
      i.fa-solid.fa-arrow-left aria-hidden="true"
      span = t("meetia.dashboard.leads.back_to_deal")

.db-v2-bottom-card
  .db-v2-bottom-card__header.db-v2-bottom-card__header--split
    h2.db-v2-bottom-card__title = t("meetia.dashboard.leads.list_title")
    span.db-v2-deals-count = t("meetia.dashboard.common.count", count: @user_progresses.size)
  .db-v2-bottom-card__body
    - if @user_progresses.empty?
      .db-v2-empty-state
        .db-v2-empty-state__icon
          i.fa-solid.fa-user-group aria-hidden="true"
        p.db-v2-empty-state__text = t("meetia.dashboard.leads.empty")
    - else
      .db-v2-leads-table-wrap
        table.db-v2-leads-table
          thead
            tr
              th = t("meetia.dashboard.leads.col_id")
              th = t("meetia.dashboard.leads.col_name")
              th = t("meetia.dashboard.leads.col_job")
              th = t("meetia.dashboard.leads.col_company")
              th = t("meetia.dashboard.leads.col_email")
              th = t("meetia.dashboard.leads.col_prospect")
              th = t("meetia.dashboard.leads.col_satisfaction")
              th = t("meetia.dashboard.leads.col_phase")
              th = t("meetia.dashboard.leads.col_intro_date")
              th = t("meetia.dashboard.leads.col_created")
              th = t("meetia.dashboard.leads.col_actions")
          tbody
            - @user_progresses.each do |progress|
              - evaluation = @evaluations_by_user_id[progress.user_id]
              tr
                td.db-v2-deals-table__id = progress.id
                td.db-v2-deals-table__title = progress.user&.name.presence || "—"
                td= progress.user&.job_title.presence || "—"
                td= progress.user&.company.presence || "—"
                td= progress.user&.email.presence || "—"
                td
                  - if progress.prospect_grade.present?
                    | #{progress.prospect_grade}
                    - if progress.prospect_score.present?
                      = t("meetia.dashboard.leads.score_paren", score: progress.prospect_score)
                  - else
                    | —
                td= evaluation ? "#{evaluation.rating}/5" : "—"
                td= progress.consideration_phase.present? ? t("meetia.dashboard.phases.#{progress.consideration_phase}", default: progress.consideration_phase.humanize) : "—"
                td= progress.planned_introduction_date.presence || "—"
                td= l(progress.created_at, format: :short)
                td
                  .db-v2-deals-table__actions
                    = link_to dashboard_deal_user_progress_path(@deal, progress), class: "db-v2-btn db-v2-btn--primary db-v2-btn--xs" do
                      i.fa-solid.fa-arrow-up-right-from-square aria-hidden="true"
                      span = t("meetia.dashboard.leads.detail")
