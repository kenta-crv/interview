<div class="meetia-auth__page">
  <%= link_to root_path, class: "meetia-auth__brand" do %>
    <%= image_tag "meetia_logo.png", alt: "Meetia", class: "meetia-auth__logo" %>
  <% end %>

  <div class="meetia-auth__card">
    <h1 class="meetia-auth__title"><%= t("meetia.auth.password_edit_title") %></h1>
    <p class="meetia-auth__lead"><%= t("meetia.auth.password_edit_lead") %></p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "admins/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="meetia-auth__field">
        <%= f.label :password, t("meetia.auth.new_password"), class: "meetia-auth__label" %>
        <% if @minimum_password_length %>
          <em class="meetia-auth__hint"><%= t("meetia.auth.password_hint", count: @minimum_password_length) %></em>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "meetia-auth__input" %>
      </div>

      <div class="meetia-auth__field">
        <%= f.label :password_confirmation, t("meetia.auth.new_password_confirmation"), class: "meetia-auth__label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "meetia-auth__input" %>
      </div>

      <%= f.submit t("meetia.auth.submit_password_update"), class: "meetia-btn meetia-btn--primary meetia-btn--lg meetia-auth__submit" %>
    <% end %>
  </div>

  <div class="meetia-auth__links">
    <%= render "admins/shared/links" %>
  </div>
</div>
