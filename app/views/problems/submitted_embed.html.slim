doctype html
html lang=I18n.locale
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    - dash_url = dashboard_index_path
    meta http-equiv="refresh" content="0;url=#{dash_url}"
    title = t("meetia.problems.submitted_title")
  body
    p = t("meetia.problems.submitted_redirect")
    script type="text/javascript"
      | (function () {
          var url = #{dash_url.to_json};
          try {
            if (window.parent && window.parent !== window) {
              window.parent.postMessage({ type: "meetia:problem-report-submitted", url: url }, window.location.origin);
              window.parent.location.assign(url);
              return;
            }
          } catch (e) {}
          try {
            if (window.opener && !window.opener.closed) {
              window.opener.location.assign(url);
              window.close();
              return;
            }
          } catch (e) {}
          window.location.assign(url);
        })();
