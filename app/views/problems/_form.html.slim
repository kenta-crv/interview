- embed = local_assigns.fetch(:embed, false)
- problem = local_assigns.fetch(:problem, @problem)

= form_with model: problem, url: problems_path, local: true, html: { class: "db-v2-problem-form", multipart: true, data: { turbo: false } } do |f|
  - if embed
    = hidden_field_tag :embed, "1"

  - if problem.errors.any?
    .db-v2-alert.db-v2-alert--danger
      ul
        - problem.errors.full_messages.each do |message|
          li = message

  .db-v2-form-group
    = f.label :company, class: "db-v2-form-label" do
      = t("meetia.problems.company")
      span.db-v2-form-label__req = t("meetia.common.required")
    = f.text_field :company, class: "db-v2-form-control", placeholder: t("meetia.problems.company_ph"), required: true, autocomplete: "organization"

  .db-v2-form-group
    = f.label :email, class: "db-v2-form-label" do
      = t("meetia.problems.email")
      span.db-v2-form-label__req = t("meetia.common.required")
    = f.email_field :email, class: "db-v2-form-control", placeholder: "you@example.com", required: true, autocomplete: "email"

  .db-v2-form-group
    = f.label :photo, class: "db-v2-form-label" do
      = t("meetia.problems.photo")
      span.db-v2-form-label__opt = t("meetia.common.optional")
    = f.file_field :photo, class: "db-v2-form-control db-v2-form-control--file", accept: "image/*"
    span.db-v2-form-hint = t("meetia.problems.photo_hint")

  .db-v2-form-group
    = f.label :body, class: "db-v2-form-label" do
      = t("meetia.problems.body")
      span.db-v2-form-label__opt = t("meetia.common.optional")
    = f.text_area :body, class: "db-v2-form-control", rows: 5, placeholder: t("meetia.problems.body_ph")

  .db-v2-form-actions
    = f.submit t("meetia.problems.submit"), class: "db-v2-btn db-v2-btn--primary"
