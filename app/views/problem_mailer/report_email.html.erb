<p><%= t("meetia.problems.mail_intro") %></p>

<table>
  <tr>
    <th><%= t("meetia.problems.company") %></th>
    <td><%= @problem.company %></td>
  </tr>
  <tr>
    <th><%= t("meetia.problems.email") %></th>
    <td><%= @problem.email %></td>
  </tr>
  <tr>
    <th><%= t("meetia.problems.body") %></th>
    <td>
      <% if @problem.respond_to?(:message) && @problem.message.present? %>
        <%= simple_format(@problem.message) %>
      <% elsif @problem.respond_to?(:body) && @problem.body.present? %>
        <%= simple_format(@problem.body) %>
      <% else %>
        <span style="color: #999;"><%= t("meetia.problems.mail_empty") %></span>
      <% end %>
    </td>
  </tr>
</table>

<% if @problem.photo.present? %>
  <% filename = @problem.photo.identifier.to_s %>
  <% attachment = filename.present? ? attachments[filename] : nil %>
  <% if attachment.present? %>
    <p><%= t("meetia.problems.mail_photo") %>:</p>
    <p>
      <%= image_tag attachment.url, width: 400 %>
    </p>
  <% else %>
    <p><%= t("meetia.problems.mail_photo_named", name: filename.presence || t("meetia.problems.mail_unknown_file")) %></p>
  <% end %>
<% end %>
