- visible_plans = Subscription.lp_display_plans
- current_plan = current_client.subscription_plan.to_s
- billing_currency = BillingCurrency.resolve(locale: I18n.locale, accept_language: request.headers["Accept-Language"])
- currency_symbol = BillingCurrency.symbol(billing_currency)

.db-v2-pricing-panel
  .db-v2-pricing__grid
    - visible_plans.each do |plan_key, config|
      - is_trial = plan_key == :trial
      - next if is_trial && !@is_new_account
      - display_price = Subscription.price_for(plan_key, currency: billing_currency)
      - card_classes = []
      - card_classes << "db-v2-pricing__card--popular" if config[:popular]
      - card_classes << "db-v2-pricing__card--featured" if config[:featured]
      - card_classes << "db-v2-pricing__card--trial" if is_trial
      - card_classes << "db-v2-pricing__card--current" if current_plan == plan_key.to_s
      .db-v2-pricing__card class=card_classes.join(" ")
        - badge_items = []
        - badge_items << ["db-v2-pricing__badge--popular", "POPULAR"] if config[:popular]
        - badge_items << ["db-v2-pricing__badge--featured", "RECOMMENDED"] if config[:featured]
        - badge_items << ["db-v2-pricing__badge--trial", "FREE TRIAL"] if is_trial
        - if badge_items.any?
          .db-v2-pricing__badges
            - badge_items.each do |badge_class, badge_label|
              span.db-v2-pricing__badge class=badge_class = badge_label
        .db-v2-pricing__card-head
          h3.db-v2-pricing__plan = lp_plan_name(config)
          - if plan_key == :standard && current_client.intro_discount_eligible?
            - intro_price = Subscription.intro_price_for(:standard, currency: billing_currency)
            .db-v2-pricing__price.db-v2-pricing__price--sale
              p.db-v2-pricing__list
                span.db-v2-pricing__currency = currency_symbol
                span.db-v2-pricing__amount.db-v2-pricing__amount--list = number_with_delimiter(display_price)
              p.db-v2-pricing__sale
                span.db-v2-pricing__currency.db-v2-pricing__currency--sale = currency_symbol
                span.db-v2-pricing__amount.db-v2-pricing__amount--sale = number_with_delimiter(intro_price)
                span.db-v2-pricing__period = t("meetia.auth.pricing_per_month")
              p.db-v2-pricing__sale-note
                = t("meetia.auth.intro_discount_title", percent: Subscription::STANDARD_INTRO_PERCENT_OFF, months: Subscription::STANDARD_INTRO_MONTHS)
          - else
            .db-v2-pricing__price
              span.db-v2-pricing__currency = currency_symbol
              span.db-v2-pricing__amount = number_with_delimiter(display_price)
              - if is_trial
                span.db-v2-pricing__period = t("meetia.auth.pricing_per_days", days: Subscription::TRIAL_DAYS)
              - else
                span.db-v2-pricing__period = t("meetia.auth.pricing_per_month")
          p.db-v2-pricing__desc = lp_plan_description(config)
        ul.db-v2-pricing__features
          - lp_comparison_features.each do |feature|
            li.db-v2-pricing__feature
              span.db-v2-pricing__feature-label = feature[:label]
              span.db-v2-pricing__feature-value = Subscription.format_feature_value(plan_key, feature[:key])
        .db-v2-pricing__card-foot
          - if current_plan == plan_key.to_s
            span.db-v2-btn.db-v2-btn--ghost.db-v2-btn--block.is-disabled = t("meetia.auth.pricing_selected")
          - elsif is_trial
            = button_to t("meetia.auth.pricing_start_trial"), select_plan_path_for_locale, method: :post, params: { plan_type: "trial" }, class: "db-v2-btn db-v2-btn--primary db-v2-btn--block"
          - elsif config[:purchasable]
            = button_to t("meetia.auth.pricing_choose"), select_plan_path_for_locale, method: :post, params: { plan_type: plan_key }, class: "db-v2-btn db-v2-btn--primary db-v2-btn--block"
