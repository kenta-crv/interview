# Sidekiq systemd サービスファイル（meetia 本番）
# 設置先: /etc/systemd/system/sidekiq-meetia.service
#
# 初回セットアップ:
#   cd /opt/webroot/meetia
#   bash bin/setup_sidekiq.sh
#
# または手動:
#   sudo cp config/sidekiq-meetia.service /etc/systemd/system/sidekiq-meetia.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable sidekiq-meetia
#   sudo systemctl start sidekiq-meetia
#
# デプロイ後:
#   sudo systemctl restart sidekiq-meetia
#
# 確認:
#   sudo systemctl status sidekiq-meetia
#   journalctl -u sidekiq-meetia -f

[Unit]
Description=sidekiq for meetia (production)
After=network.target redis-server.service redis.service
Wants=redis-server.service redis.service

[Service]
Type=simple

WorkingDirectory=/opt/webroot/meetia
User=smart
Group=smart

Environment=RAILS_ENV=production
Environment=MALLOC_ARENA_MAX=2
Environment=SIDEKIQ_CONCURRENCY=5
Environment=RAILS_MAX_THREADS=10
EnvironmentFile=-/opt/webroot/meetia/.env

# rbenv 利用時はログインシェル経由で bundle を解決する
ExecStart=/bin/bash -lc 'cd /opt/webroot/meetia && bundle exec sidekiq -C config/sidekiq.yml'
ExecStop=/bin/kill -TERM $MAINPID

Restart=always
RestartSec=3

SyslogIdentifier=sidekiq-meetia
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
