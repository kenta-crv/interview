<p><%= @intro %></p>

<p><strong><%= t("meetia.owner_mail.deal") %>：</strong><%= @deal.title %></p>

<table style="border-collapse:collapse;width:100%;max-width:560px;">
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;width:140px;"><%= t("meetia.dashboard.visitor_fields.company") %></th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user.company.presence || "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= t("meetia.dashboard.visitor_fields.name") %></th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user.name.presence || "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= t("meetia.dashboard.visitor_fields.job_title") %></th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user.job_title.presence || "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= t("meetia.dashboard.visitor_fields.email") %></th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user.email.presence || "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= t("meetia.dashboard.visitor_fields.tel") %></th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user.tel.presence || "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= t("meetia.dashboard.visitor_fields.address") %></th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user.address.presence || "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= t("meetia.dashboard.visitor_fields.url") %></th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user.url.presence || "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= t("meetia.dashboard.visitor_fields.consideration_phase") %></th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @phase_label %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= t("meetia.dashboard.visitor_fields.planned_introduction_date") %></th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user_progress.planned_introduction_date.presence || "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= t("meetia.dashboard.visitor_fields.key_points_for_application") %></th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user_progress.key_points_for_application.presence || "—" %></td>
  </tr>
</table>

<p style="margin-top:24px;">
  <a href="<%= @dashboard_url %>" style="display:inline-block;padding:12px 18px;background:#2563eb;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:700;"><%= t("meetia.owner_mail.dashboard_cta") %></a>
</p>
<p style="margin:8px 0 0;font-size:12px;color:#64748b;word-break:break-all;"><%= @dashboard_url %></p>

<p style="color:#64748b;font-size:12px;margin-top:24px;"><%= t("meetia.owner_mail.source") %>: <%= @source %></p>
