.db-v2-header
  .db-v2-header__left
    h1.db-v2-header__title Management
    p.db-v2-header__subtitle = t("meetia.dashboard.management.subtitle")
  .db-v2-header__right
    = render "/dashboard/theme_switch"

nav.db-v2-tabs role="tablist" aria-label=t("meetia.dashboard.management.tabs_aria")
  a.db-v2-tabs__btn.is-active href="#management-companies"
    i.fa-solid.fa-building aria-hidden="true"
    span = t("meetia.dashboard.management.tab_companies")
  a.db-v2-tabs__btn href="#management-journeys"
    i.fa-solid.fa-route aria-hidden="true"
    span = t("meetia.dashboard.management.tab_journeys")

#management-companies.db-v2-bottom-card
  .db-v2-bottom-card__header.db-v2-bottom-card__header--split
    h2.db-v2-bottom-card__title = t("meetia.dashboard.management.list_title")
    span.db-v2-deals-count = t("meetia.dashboard.common.count_companies", count: @clients.size)

  .db-v2-bottom-card__body
    - if @clients.empty?
      .db-v2-empty-state
        .db-v2-empty-state__icon
          i.fa-solid.fa-building aria-hidden="true"
        p.db-v2-empty-state__text = t("meetia.dashboard.management.empty")
    - else
      .db-v2-leads-table-wrap
        table.db-v2-leads-table.db-v2-companies-table
          colgroup
            col.db-v2-col--company
            col.db-v2-col--email
            col.db-v2-col--contact
            col.db-v2-col--plan
            col.db-v2-col--status
            col.db-v2-col--num
            col.db-v2-col--num
            col.db-v2-col--num
            col.db-v2-col--date
            col.db-v2-col--actions
          thead
            tr
              th = t("meetia.dashboard.management.col_company")
              th = t("meetia.dashboard.management.col_email")
              th = t("meetia.dashboard.management.col_contact")
              th = t("meetia.dashboard.management.col_plan")
              th = t("meetia.dashboard.management.col_status")
              th = t("meetia.dashboard.management.col_deals")
              th = t("meetia.dashboard.management.col_live")
              th = t("meetia.dashboard.management.col_leads")
              th = t("meetia.dashboard.management.col_registered")
              th = t("meetia.dashboard.management.col_actions")
          tbody
            - @clients.each do |client|
              - plan_config = client.current_plan_config
              - deal_count = @deal_counts[client.id] || 0
              - published_count = @published_deal_counts[client.id] || 0
              - lead_count = @lead_counts[client.id] || 0
              - material_limit = plan_config[:service_limit]
              tr
                td.db-v2-deals-table__title
                  = client.company.presence || "—"
                td = client.email
                td = client.name.presence || "—"
                td = plan_config[:name]
                td
                  - if client.dashboard_accessible?
                    span.db-v2-status-badge.db-v2-status-badge--live = t("meetia.dashboard.status.active")
                  - elsif client.subscription_status == "cancelled"
                    span.db-v2-status-badge.db-v2-status-badge--fail = t("meetia.dashboard.status.cancelled")
                  - elsif client.on_trial?
                    span.db-v2-status-badge.db-v2-status-badge--progress = t("meetia.dashboard.status.trial")
                  - else
                    span.db-v2-status-badge = client.subscription_status.presence || t("meetia.dashboard.status.no_contract")
                td
                  - if material_limit
                    = "#{deal_count} / #{material_limit}"
                  - else
                    = t("meetia.dashboard.management.deals_unlimited", count: deal_count)
                td = published_count
                td = lead_count
                td= l(client.created_at, format: :short)
                td
                  = link_to t("meetia.dashboard.common.detail"), dashboard_subscription_path(client_id: client.id), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--sm"

#management-journeys.db-v2-bottom-card
  .db-v2-bottom-card__header.db-v2-bottom-card__header--split
    h2.db-v2-bottom-card__title = t("meetia.dashboard.management.journeys_title")
    span.db-v2-deals-count = t("meetia.dashboard.common.count", count: @visitor_progresses.size)

  .db-v2-bottom-card__body
    - if @visitor_progresses.empty?
      .db-v2-empty-state
        .db-v2-empty-state__icon
          i.fa-solid.fa-route aria-hidden="true"
        p.db-v2-empty-state__text = t("meetia.dashboard.management.journeys_empty")
    - else
      .db-v2-leads-table-wrap
        table.db-v2-leads-table
          thead
            tr
              th = t("meetia.dashboard.management.col_progress")
              th = t("meetia.dashboard.management.col_visitor")
              th = t("meetia.dashboard.management.col_client")
              th = t("meetia.dashboard.management.col_deal")
              th = t("meetia.dashboard.management.col_last_action")
              th = t("meetia.dashboard.management.col_last_at")
              th = t("meetia.dashboard.management.col_actions")
          tbody
            - @visitor_progresses.each do |progress|
              - journey = @journeys[progress.id]
              - last_event = journey && journey[:last_event]
              tr
                td
                  = visitor_journey_tracker(journey, compact: true)
                  span.db-v2-journey__current = visitor_journey_step_label(journey)
                td.db-v2-deals-table__title = progress.user&.name.presence || progress.user&.email.presence || t("meetia.dashboard.leads.fallback_name", id: progress.id)
                td = progress.deal&.client&.company.presence || progress.deal&.client&.email.presence || "—"
                td = progress.deal&.title.presence || "—"
                td
                  - if last_event
                    = last_event.display_event_type
                    - if journey[:last_page].present?
                      = " / "
                      = t("meetia.dashboard.common.page_number", page: journey[:last_page])
                  - else
                    | —
                td
                  - if journey && journey[:last_at]
                    = l(journey[:last_at], format: :short)
                  - else
                    = l(progress.updated_at, format: :short)
                td
                  = link_to t("meetia.dashboard.leads.detail"), dashboard_deal_user_progress_path(progress.deal, progress), class: "db-v2-btn db-v2-btn--primary db-v2-btn--xs"
