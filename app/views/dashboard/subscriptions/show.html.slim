- is_trial = @target_client.on_trial? || (@subscription&.trial? && !@subscription&.cancelled?)
- is_active = @subscription&.active? || @target_client.on_trial?
- can_cancel = subscription_can_cancel?(@target_client)

.db-v2-bottom-card
  .db-v2-bottom-card__header
    h2.db-v2-bottom-card__title
      i.fa-solid.fa-id-card aria-hidden="true"
      |  
      = t("meetia.dashboard.subscription.current_plan")
  .db-v2-bottom-card__body
    - if @subscription.present? || @target_client.on_trial?
      .db-v2-subscription-status
        .db-v2-subscription-status__row
          span.db-v2-subscription-status__label = t("meetia.dashboard.subscription.plan_type")
          span.db-v2-subscription-status__value
            - if is_trial
              = Subscription::PLAN_NAMES[:trial]
            - else
              = @subscription&.plan_name || "—"

        .db-v2-subscription-status__row
          span.db-v2-subscription-status__label = t("meetia.dashboard.subscription.status")
          span.db-v2-subscription-status__value class=("db-v2-subscription-status__value--trial" if is_trial)
            - if is_trial
              = t("meetia.dashboard.status.trialing")
            - elsif @subscription&.cancelled?
              = t("meetia.dashboard.status.cancel_pending")
            - elsif is_active
              = t("meetia.dashboard.status.active")
            - else
              = @subscription&.status || "—"

        - current_trial_ends_at = nil
        - if is_trial
          - current_trial_ends_at = @subscription&.trial_ends_at || @target_client.trial_ends_at || (@subscription&.created_at&.+ Subscription::TRIAL_DAYS.days)

        - if current_trial_ends_at.present?
          .db-v2-subscription-status__row
            span.db-v2-subscription-status__label = t("meetia.dashboard.subscription.trial_ends")
            span.db-v2-subscription-status__value = l(current_trial_ends_at.to_date, format: :long)

      - unless admin_signed_in?
        .db-v2-subscription-upgrade
          h3.db-v2-subscription-upgrade__title = t("meetia.dashboard.subscription.upgrade_title")
          = link_to plans_path, class: "db-v2-btn db-v2-btn--primary" do
            i.fa-solid.fa-tags aria-hidden="true"
            span = t("meetia.dashboard.subscription.change_plan")

        - if can_cancel
          .db-v2-subscription-cancel
            p.db-v2-subscription-cancel__note
              - if is_trial
                = t("meetia.dashboard.subscription.cancel_trial_note")
              - else
                = t("meetia.dashboard.subscription.cancel_active_note")
            = link_to t("meetia.dashboard.subscription.cancel_cta"), cancel_confirm_dashboard_subscription_path(subscription_path_options), class: "db-v2-btn db-v2-btn--danger"

    - else
      .db-v2-empty-state
        p.db-v2-empty-state__text = t("meetia.dashboard.subscription.empty")
        = link_to plans_path, class: "db-v2-btn db-v2-btn--primary" do
          span = t("meetia.dashboard.subscription.choose_plan")

.db-v2-bottom-card
  .db-v2-bottom-card__header
    h2.db-v2-bottom-card__title = t("meetia.dashboard.subscription.payments")
  .db-v2-bottom-card__body
    - if @payments.present?
      .db-v2-leads-table-wrap
        table.db-v2-leads-table
          thead
            tr
              th = t("meetia.dashboard.subscription.col_date")
              th = t("meetia.dashboard.subscription.col_amount")
              th = t("meetia.dashboard.subscription.col_desc")
              th = t("meetia.dashboard.subscription.col_status")
          tbody
            - @payments.each do |payment|
              tr
                td = payment.created_at.strftime("%Y/%m/%d")
                td = payment.respond_to?(:formatted_amount) ? payment.formatted_amount : "¥#{number_with_delimiter(payment.amount)}"
                td = payment.try(:description) || "—"
                td = payment.status
    - else
      p.db-v2-empty-state__text = t("meetia.dashboard.subscription.no_payments")
