.db-v2-header
  .db-v2-header__left
    h1.db-v2-header__title = t("meetia.interview.results_index_title")
    p.db-v2-header__subtitle = t("meetia.interview.results_index_sub")
  .db-v2-header__right
    = render "/dashboard/theme_switch"

.db-v2-bottom-card
  .db-v2-bottom-card__header.db-v2-bottom-card__header--split
    h2.db-v2-bottom-card__title = t("meetia.interview.results_list")
    span.db-v2-deals-count = t("meetia.dashboard.common.count", count: @results.size)

  .db-v2-bottom-card__body
    - if @results.empty?
      .db-v2-empty-state
        .db-v2-empty-state__icon
          i.fa-solid.fa-clipboard-list aria-hidden="true"
        p.db-v2-empty-state__text = t("meetia.interview.results_empty")
    - else
      .db-v2-leads-table-wrap
        table.db-v2-leads-table
          thead
            tr
              th ID
              th = t("meetia.interview.applicant")
              th = t("meetia.interview.scenario")
              th = t("meetia.interview.status")
              th = t("meetia.interview.avg_score")
              th = t("meetia.interview.created")
              th
          tbody
            - @results.each do |result|
              tr
                td = result.id
                td = result.interview.user&.email
                td = result.interview.situation&.title
                td = result.final_status
                td = result.average_score
                td = l(result.created_at, format: :short)
                td
                  = link_to t("meetia.dashboard.common.detail"), admin_interview_result_path(result), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--sm"
