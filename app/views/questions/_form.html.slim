= form_with model: [@situation, @question], local: true do |f|
  .form-group
    = f.label :question_text, t("meetia.questions.question_text")
    = f.text_area :question_text, class: 'form-control', rows: 3

  .form-group
    = f.label :question_type, t("meetia.questions.question_type")
    = f.select :question_type, options_for_select([[t("meetia.questions.type_text"), 'text'], [t("meetia.questions.type_choice"), 'choice']], @question.question_type), {}, class: 'form-control'

  .form-group
    = f.label :options, t("meetia.questions.options")
    = f.text_area :options, class: 'form-control', rows: 2, placeholder: '{"choices":["A","B"],"correct":"A"}'

  .form-group
    = f.label :order, t("meetia.questions.order")
    = f.number_field :order, class: 'form-control'

  .form-group
    .form-check
      = f.check_box :required, class: 'form-check-input'
      = f.label :required, t("meetia.questions.required"), class: 'form-check-label'

  .form-group
    = f.label :category, t("meetia.questions.category")
    = f.text_field :category, class: 'form-control', placeholder: t("meetia.questions.category_ph")

  .form-group
    = f.label :branching_rules, t("meetia.questions.branching")
    = f.text_area :branching_rules, class: 'form-control', rows: 4, placeholder: '{"conditions":[{"source_question_order":1,"type":"selected_option","value":"Python","action":"include"}],"default_action":"skip"}'
    small.form-text.text-muted
      = t("meetia.questions.branching_hint")

  = f.submit t("meetia.dashboard.common.save"), class: 'btn btn-primary'
