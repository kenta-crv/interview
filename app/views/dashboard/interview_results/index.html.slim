h1 = t("meetia.interview.results_index_title")

.table-wrapper
  table
    thead
      tr
        th ID
        th = t("meetia.interview.applicant")
        th = t("meetia.interview.scenario")
        th = t("meetia.interview.status")
        th = t("meetia.interview.avg_score")
        th = t("meetia.interview.created")
        th
    tbody
      - @results.each do |result|
        tr
          td= result.id
          td= result.interview.user&.email
          td= result.interview.situation&.title
          td= result.final_status
          td= result.average_score
          td= l(result.created_at, format: :short)
          td= link_to t("meetia.dashboard.common.detail"), dashboard_interview_result_path(result)
