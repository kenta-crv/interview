javascript:
  var accessToken = null;

script type="application/json" id="interview-i18n"
  = raw json_escape(t("meetia.interview.js").to_json)

.section-interview
  .interview-container
    .step-indicator
      .step-indicator__item.active data-step="1"
        .step-indicator__number 1
        .step-indicator__label = t("meetia.interview.step_select")
      .step-indicator__item data-step="2"
        .step-indicator__number 2
        .step-indicator__label = t("meetia.interview.step_run")
      .step-indicator__item data-step="3"
        .step-indicator__number 3
        .step-indicator__label = t("meetia.interview.step_result")

    #step-1.step.active
      .interview-card.interview-card--hero
        h1 = t("meetia.interview.title")
        p = t("meetia.interview.lead")

        .form-group
          label.form-label = t("meetia.interview.form_label")
          select#situation_id.form-input
            option value="" = t("meetia.interview.form_blank")
            - @situations.each do |s|
              option value=s.id #{s.title}

        .form-group
          label.form-label = t("meetia.interview.language_label")
          select#language.form-input
            option value="ja" = t("meetia.interview.language_ja")
            option value="en" = t("meetia.interview.language_en")

        .interview-actions
          button#start_interview.btn-start = t("meetia.interview.start")
          button#resume_interview.btn-resume style="display:none" = t("meetia.interview.resume")

    #step-2.step
      .interview-card
        .interview-header
          h2 = t("meetia.interview.in_progress")
          span#interview_status.status-badge = t("meetia.interview.ready")
        .interview-progress
          .interview-progress__bar
            span#progress_bar
        .interview-meta
          span#progress_text 0%
          span#question_count = t("meetia.interview.js.question_count", answered: 0, total: 0)

      .interview-card
        h2 = t("meetia.interview.question")
        .avatar
          .avatar__icon
          .avatar__label = t("meetia.interview.interviewer")
        p#question_text.question-display = t("meetia.interview.click_to_start")
        audio#question_audio controls=true
        #mcq_options.mcq-options

      .interview-card
        h2 = t("meetia.interview.your_answer")
        .form-group
          label.form-label = t("meetia.interview.text_answer")
          textarea#text_answer.form-input rows="3" placeholder=t("meetia.interview.text_ph")

        .recorder
          label.form-label = t("meetia.interview.voice_answer")
          .recorder__controls
            button#record_start.btn-record = t("meetia.interview.record_start")
            button#record_stop.btn-record.btn-record--stop disabled=true = t("meetia.interview.record_stop")
            span#record_status.record-status = t("meetia.interview.record_idle")
          audio#recorded_audio controls=true

        .form-group
          label.form-label = t("meetia.interview.upload_audio")
          input#audio_file.form-file type="file" accept="audio/*"

        .form-group
          label.form-label = t("meetia.interview.upload_video")
          input#video_file.form-file type="file" accept="video/*"

        .interview-actions
          button#submit_answer.btn-start = t("meetia.interview.submit_answer")
          button#complete_interview.btn-complete style="display:none" = t("meetia.interview.complete")

    #step-3.step
      .interview-card.interview-card--result
        h2 = t("meetia.interview.result_title")
        p#result_status.result-message = t("meetia.interview.result_loading")

        .result-grid
          .result-item
            .result-item__label = t("meetia.interview.verdict")
            .result-item__value#result_final_status -
          .result-item
            .result-item__label = t("meetia.interview.avg_score")
            .result-item__value#result_avg_score -
          .result-item
            .result-item__label = t("meetia.interview.answer_count")
            .result-item__value#result_qs -

      .interview-card
        h3 = t("meetia.interview.summary")
        p#result_summary -

      .interview-card
        h3 = t("meetia.interview.strengths")
        ul#result_strengths

      .interview-card
        h3 = t("meetia.interview.improvements")
        ul#result_weaknesses

      .interview-card
        h3 = t("meetia.interview.recommendation")
        p#result_recommendation -

      .interview-actions.interview-actions--center
        button#back_to_start.btn-resume = t("meetia.interview.back")
