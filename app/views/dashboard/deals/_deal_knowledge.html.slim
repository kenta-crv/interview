.db-v2-bottom-card#deal-knowledge
  .db-v2-bottom-card__header.db-v2-bottom-card__header--split
    h2.db-v2-bottom-card__title
      i.fa-solid.fa-lightbulb aria-hidden="true"
      = t("meetia.dashboard.knowledge.title")
    - if deal_owner.show_knowledge_coverage? && @deal.deal_faqs.where(source: Deal::SYSTEM_FAQ_SOURCES).exists?
      span.db-v2-lang-badge = t("meetia.dashboard.knowledge.coverage", pct: @knowledge_coverage)

  .db-v2-bottom-card__body
    - if @pending_faq_count.positive? && !deal_owner.knowledge_section_optional?
      p.db-v2-muted = t("meetia.dashboard.knowledge.pending_count", count: @pending_faq_count)

    .deal-knowledge-supplement
      .deal-knowledge-supplement__head
        h3.db-v2-subsection-title = t("meetia.dashboard.knowledge.supplement_title")
        span.db-v2-muted = t("meetia.dashboard.knowledge.supplement_hint", max: Deal::MAX_SUPPLEMENT_DOCUMENTS)
      - supplement_limit_reached = @deal.supplement_upload_limit_reached?
      - if supplement_limit_reached
        p.db-v2-muted = t("meetia.dashboard.knowledge.supplement_max", max: Deal::MAX_SUPPLEMENT_DOCUMENTS)
      - else
        = form_tag upload_supplement_documents_dashboard_deal_path(@deal), multipart: true, class: "deal-supplement-upload", data: { turbo: false } do
          label.db-v2-btn.db-v2-btn--ghost.db-v2-btn--xs.deal-supplement-upload__pick for="deal-supplement-input"
            = file_field_tag "files[]", multiple: true, accept: ".pdf", id: "deal-supplement-input", class: "deal-supplement-upload__input"
            span = t("meetia.dashboard.deals.choose_file")
          = submit_tag t("meetia.dashboard.knowledge.upload_supplement"), class: "db-v2-btn db-v2-btn--primary db-v2-btn--xs", data: { turbo: false }
      - if @supplement_documents.any?
        ul.deal-supplement-list
          - @supplement_documents.each do |doc|
            li = File.basename(doc.file.filename.to_s)

    - if @deal_faqs.any?
      .deal-faq-list
        - @deal_faqs.each do |faq|
          details.deal-faq-item class=("deal-faq-item--pending" if faq.pending?)
            summary.deal-faq-item__summary
              span.deal-faq-item__toggle aria-hidden="true"
              .deal-faq-item__summary-main
                span.deal-faq-item__question = faq.question.truncate(72)
                .deal-faq-item__meta
                  span.deal-faq-item__category = faq.category_label
                  span.deal-faq-item__badge class=("deal-faq-item__badge--muted" if faq.source == "template") = faq.source_label
                  - if faq.pending?
                    span.deal-faq-item__badge.deal-faq-item__badge--warn = t("meetia.dashboard.knowledge.unanswered")
                  - elsif faq.answered?
                    span.deal-faq-item__badge.deal-faq-item__badge--ok = t("meetia.dashboard.knowledge.answered")

            .deal-faq-item__body
              = form_with model: faq, url: dashboard_deal_deal_faq_path(@deal, faq), method: :patch, local: true, html: { class: "deal-faq-form" } do |f|
                .db-v2-form-group
                  = f.label :question, t("meetia.dashboard.knowledge.question"), class: "db-v2-form-label"
                  = f.text_area :question, class: "db-v2-form-control", rows: 2, readonly: faq.ai_gap? && faq.pending?
                .db-v2-form-group
                  = f.label :answer, t("meetia.dashboard.knowledge.answer"), class: "db-v2-form-label"
                  = f.text_area :answer, class: "db-v2-form-control", rows: 3, placeholder: (faq.pending? ? t("meetia.dashboard.knowledge.answer_ph") : "")
                .db-v2-form-group
                  = f.label :category, t("meetia.dashboard.knowledge.category"), class: "db-v2-form-label"
                  = f.select :category, DealFaq::CATEGORIES.keys.map { |k| [t("meetia.dashboard.faq.categories.#{k}"), k] }, {}, class: "db-v2-form-control"
                .deal-faq-item__actions
                  = f.submit t("meetia.dashboard.common.save"), class: "db-v2-btn db-v2-btn--primary db-v2-btn--xs"
                  - if faq.pending?
                    = button_to t("meetia.dashboard.common.skip"), skip_dashboard_deal_deal_faq_path(@deal, faq), method: :post, class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs", form: { class: "db-v2-inline-form" }, data: { turbo: false }
                  = button_to t("meetia.dashboard.common.delete"), dashboard_deal_deal_faq_path(@deal, faq), method: :delete, class: "db-v2-btn db-v2-btn--danger db-v2-btn--xs", form: { class: "db-v2-inline-form" }, data: { turbo: false, confirm: t("meetia.dashboard.knowledge.delete_confirm") }
    - else
      p.db-v2-muted.deal-knowledge-empty
        - if @deal.deal_summary.present?
          = t("meetia.dashboard.knowledge.empty_ready")
        - else
          = t("meetia.dashboard.knowledge.empty_waiting")

    details.deal-faq-advanced class=(deal_owner.gap_analysis_suggest_only? ? "deal-faq-advanced--trial" : "")
      summary.deal-faq-advanced__summary
        - if deal_owner.gap_analysis_suggest_only?
          = t("meetia.dashboard.knowledge.tools_trial")
        - else
          = t("meetia.dashboard.knowledge.tools")
      .deal-faq-advanced__body
        .deal-faq-tools
          = button_to t("meetia.dashboard.knowledge.suggest_from_docs"), analyze_gaps_dashboard_deal_deal_faqs_path(@deal), method: :post, class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs", form: { class: "db-v2-inline-form" }, disabled: @deal.deal_summary.blank?, data: { turbo: false }
          = button_to t("meetia.dashboard.knowledge.suggest_from_logs"), suggest_from_events_dashboard_deal_deal_faqs_path(@deal), method: :post, class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs", form: { class: "db-v2-inline-form" }, data: { turbo: false }
          = button_to t("meetia.dashboard.knowledge.stress_test"), stress_test_dashboard_deal_deal_faqs_path(@deal), method: :post, class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs", form: { class: "db-v2-inline-form" }, disabled: @deal.deal_summary.blank?, data: { turbo: false }

        = form_with model: DealFaq.new, url: dashboard_deal_deal_faqs_path(@deal), local: true, html: { class: "deal-faq-create-form" } do |f|
          .db-v2-form-group
            = f.label :question, t("meetia.dashboard.knowledge.add_manual"), class: "db-v2-form-label"
            = f.text_area :question, class: "db-v2-form-control", rows: 2, placeholder: t("meetia.dashboard.knowledge.add_question_ph")
          .db-v2-form-group
            = f.label :answer, t("meetia.dashboard.knowledge.answer"), class: "db-v2-form-label"
            = f.text_area :answer, class: "db-v2-form-control", rows: 3, placeholder: t("meetia.dashboard.knowledge.add_answer_ph")
          .db-v2-form-group
            = f.label :category, t("meetia.dashboard.knowledge.category"), class: "db-v2-form-label"
            = f.select :category, DealFaq::CATEGORIES.keys.map { |k| [t("meetia.dashboard.faq.categories.#{k}"), k] }, {}, class: "db-v2-form-control"
          = f.submit t("meetia.dashboard.knowledge.add_faq"), class: "db-v2-btn db-v2-btn--primary db-v2-btn--xs"
