doctype html
html lang="ja" data-turbo="false"
  head
    = render "layouts/head"
    meta name="turbo-visit-control" content="reload"
    meta name="turbo-cache-control" content="no-cache"
    style type="text/css"
      | html,body.presentation-body{margin:0!important;padding:0!important;overflow:hidden!important;background:#0a0b1e!important}
      | #presentation-start-overlay{position:fixed!important;inset:0!important;z-index:2147483647!important;display:flex!important;align-items:center!important;justify-content:center!important;background:rgba(5,7,10,.78)!important;backdrop-filter:blur(14px)!important;-webkit-backdrop-filter:blur(14px)!important}
      | #presentation-start-overlay[hidden]{display:none!important}
      | #presentation-start-overlay .presentation-start-card{display:block!important;background:#fff!important;border:none!important;border-radius:24px!important;padding:48px 56px!important;text-align:center!important;box-shadow:0 25px 60px rgba(0,0,0,.5)!important;max-width:440px!important;cursor:pointer!important}
      | #presentation-start-overlay .presentation-start-title{font-size:24px!important;font-weight:700!important;color:#0f172a!important;margin:0 0 8px!important}
      | #presentation-start-overlay .presentation-start-desc{font-size:14px!important;color:#64748b!important;margin:0!important}
      | #presentation-start-overlay .presentation-start-icon{display:block!important;font-size:40px!important;margin-bottom:16px!important}
      | body.presentation-locked .presentation-wrapper{filter:blur(8px)!important;pointer-events:none!important}
      | .presentation-body .presentation-exit-modal.presentation-exit-modal--open{display:flex!important}
      | .presentation-body .presentation-exit-modal{display:none!important;align-items:center!important;justify-content:center!important}
      | .presentation-body .presentation-exit-actions{display:grid!important;grid-template-columns:1fr 1fr!important;gap:12px!important;margin:4px 0 20px!important;width:100%!important;box-sizing:border-box!important}
      | .presentation-body .btn-exit-action{display:inline-flex!important;align-items:center!important;justify-content:center!important;width:100%!important;min-height:48px!important;padding:12px 16px!important;border-radius:12px!important;font-size:14px!important;font-weight:700!important;line-height:1.3!important;text-align:center!important;text-decoration:none!important;box-sizing:border-box!important;cursor:pointer!important;white-space:normal!important}
      | .presentation-body .btn-exit-action--primary{border:none!important;background:linear-gradient(135deg,#7c3aed 0%,#a855f7 100%)!important;color:#fff!important;box-shadow:0 8px 22px rgba(124,58,237,.32)!important}
      | .presentation-body .btn-exit-action--secondary{border:1px solid #d1d5db!important;background:#fff!important;color:#334155!important;box-shadow:none!important}
      | .presentation-body .presentation-chat-panel--closed .presentation-chat-panel__body{display:none!important}
      | .presentation-body .presentation-left{gap:14px!important}
      | .presentation-body .presentation-bottom-controls{padding-left:92px!important;padding-top:4px!important;box-sizing:border-box!important}
      | .presentation-controls-row{display:grid!important;grid-template-columns:minmax(0,1fr) 56px minmax(0,1fr)!important;align-items:center!important;gap:10px!important;width:100%!important;min-width:0!important;position:relative!important}
      | .presentation-choice-scroller-wrap--left .presentation-choice-track{justify-content:flex-end!important}
      | .presentation-choice-scroller-wrap--right .presentation-choice-track{justify-content:flex-start!important}
      | .presentation-controls-row>.presentation-choice-more--prev{position:absolute!important;left:0!important;top:50%!important;transform:translateY(-50%)!important;z-index:4!important}
      | .presentation-controls-row>.presentation-choice-more:not(.presentation-choice-more--prev){position:absolute!important;right:0!important;top:50%!important;transform:translateY(-50%)!important;z-index:4!important}
      | .presentation-controls-row>.presentation-play-btn{position:relative!important;left:auto!important;top:auto!important;transform:none!important}
      | .presentation-body .presentation-exit-materials{display:block!important;width:100%!important;margin:0 0 16px!important}
      | .presentation-body .presentation-exit-materials__link{display:flex!important;align-items:center!important;justify-content:center!important;width:100%!important;min-height:48px!important;padding:12px 16px!important;border-radius:12px!important;border:1px solid #d1d5db!important;background:#fff!important;color:#334155!important;font-size:14px!important;font-weight:700!important;text-decoration:none!important;box-sizing:border-box!important}
      | .presentation-room-header__actions{display:flex!important;align-items:center!important;gap:8px!important;flex-wrap:wrap!important}
      | .presentation-body .btn-presentation-cta{display:inline-flex!important;align-items:center!important;justify-content:center!important;padding:10px 22px!important;border:none!important;border-radius:999px!important;background:linear-gradient(135deg,#7c3aed 0%,#a855f7 100%)!important;color:#fff!important;font-size:13px!important;font-weight:700!important;cursor:pointer!important;box-shadow:0 8px 24px rgba(124,58,237,.28)!important;text-decoration:none!important;flex-shrink:0!important;white-space:nowrap!important}
      | .presentation-body .btn-presentation-cta--primary{background:linear-gradient(135deg,#7c3aed 0%,#a855f7 100%)!important;color:#fff!important}
      | .presentation-body .btn-presentation-cta--primary:hover{background:linear-gradient(135deg,#6d28d9 0%,#9333ea 100%)!important;box-shadow:0 10px 26px rgba(124,58,237,.38)!important;transform:translateY(-1px)!important}
      | .presentation-body .btn-presentation-cta--secondary{border:1px solid rgba(168,85,247,.26)!important;background:rgba(15,23,42,.55)!important;color:#e2e8f0!important;box-shadow:0 6px 18px rgba(15,23,42,.2)!important}
      | .presentation-body .btn-presentation-cta--secondary:hover{background:rgba(30,41,59,.85)!important;border-color:rgba(196,181,253,.45)!important;color:#fff!important;transform:translateY(-1px)!important}
      | .presentation-body .btn-presentation-cta--header{padding:8px 14px!important;min-height:36px!important;font-size:12px!important}
      | @media (max-width:960px){.presentation-body .document-area__layout{flex-direction:column!important}.presentation-body .presentation-page-nav{flex:0 0 auto!important;width:100%!important;flex-direction:row!important;overflow-x:auto!important;overflow-y:hidden!important;gap:6px!important;padding:8px!important;border-right:none!important;border-bottom:1px solid rgba(139,92,246,.28)!important}.presentation-body .presentation-page-nav__item{flex:0 0 88px!important;width:88px!important;min-width:88px!important;max-width:88px!important;padding:6px 4px!important;box-sizing:border-box!important}.presentation-body .presentation-page-nav__title{display:-webkit-box!important;-webkit-line-clamp:3!important;-webkit-box-orient:vertical!important;overflow:hidden!important;white-space:normal!important;word-break:break-word!important;overflow-wrap:anywhere!important;line-height:1.3!important;font-size:9px!important}.presentation-body .document-viewport{flex:1 1 0!important;min-height:0!important;width:100%!important}.presentation-body .presentation-bottom-controls{padding-left:0!important;padding-right:0!important}.document-pdf-clean,.document-pdf-canvas{border-radius:0 0 20px 20px!important}}
      | @media (max-width:640px){.presentation-body .presentation-page-nav__item{flex:0 0 80px!important;width:80px!important;min-width:80px!important;max-width:80px!important}.presentation-body .presentation-page-nav__title{-webkit-line-clamp:2!important;font-size:8px!important}}
  body.presentation-body data-turbo="false"
    = yield
    script
      | (function(){var o=document.getElementById('presentation-start-overlay');if(!o)return;o.hidden=false;o.style.display='flex';document.body.classList.add('presentation-locked');})();
    = javascript_include_tag "pdf.min"
    script
      | if(window.pdfjsLib){pdfjsLib.GlobalWorkerOptions.workerSrc="/pdf.worker.min.js";}
    = javascript_include_tag "meetia_page_init", defer: true
    = javascript_include_tag "deal_presentation", defer: true
