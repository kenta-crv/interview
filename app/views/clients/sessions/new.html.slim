- set_meta_tags title: t("meetia.auth.meta_login_title"), description: t("meetia.auth.meta_login_description")

.meetia-auth__page
  = link_to locale_root_href, class: "meetia-auth__brand" do
    = image_tag "meetia_logo.png", alt: "Meetia", class: "meetia-auth__logo"

  .meetia-auth__lang
    = render "shared/lang_switch"

  .meetia-auth__card
    h1.meetia-auth__title = t("meetia.auth.login_title")
    p.meetia-auth__lead = t("meetia.auth.login_lead")

    = render "clients/shared/oauth_buttons"

    = form_for(resource, as: resource_name, url: client_session_url_for_locale) do |f|
      .meetia-auth__field
        = f.label :email, t("meetia.auth.email"), class: "meetia-auth__label"
        = f.email_field :email, autofocus: true, autocomplete: "email", class: "meetia-auth__input"

      .meetia-auth__field
        = f.label :password, t("meetia.auth.password"), class: "meetia-auth__label"
        = f.password_field :password, autocomplete: "current-password", class: "meetia-auth__input"

      - if devise_mapping.rememberable?
        .meetia-auth__remember
          = f.check_box :remember_me
          = f.label :remember_me, t("meetia.auth.remember_me")

      = f.submit t("meetia.auth.submit_login"), class: "meetia-btn meetia-btn--primary meetia-btn--lg meetia-auth__submit"

  .meetia-auth__links
    = render "clients/shared/links"
