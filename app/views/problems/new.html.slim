- if @embed
  .db-v2-problem-embed
    .db-v2-problem-embed__intro
      p.db-v2-problem-embed__lead = t("meetia.problems.embed_lead")
    = render "form", problem: @problem, embed: true
- else
  .db-v2-header
    .db-v2-header__left
      h1.db-v2-header__title = t("meetia.problems.title")
      p.db-v2-header__subtitle = t("meetia.problems.subtitle")
    .db-v2-header__right
      = render "/dashboard/theme_switch"
      = link_to dashboard_index_path, class: "db-v2-btn db-v2-btn--ghost" do
        i.fa-solid.fa-arrow-left aria-hidden="true"
        span = t("meetia.problems.back")

  .db-v2-bottom-card.db-v2-problem-page-card
    .db-v2-bottom-card__header
      h2.db-v2-bottom-card__title
        i.fa-solid.fa-bug aria-hidden="true"
        |  
        = t("meetia.problems.section")
    .db-v2-bottom-card__body
      p.db-v2-problem-page-card__lead = t("meetia.problems.page_lead")
      = render "form", problem: @problem, embed: false
