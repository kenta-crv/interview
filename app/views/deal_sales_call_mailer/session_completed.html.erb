<p style="margin:0 0 16px;font-size:15px;line-height:1.7;">AI商談が終了しました。</p>

<p style="margin:0 0 16px;"><strong>商談：</strong><%= @deal.title %></p>

<table style="border-collapse:collapse;width:100%;max-width:560px;font-size:14px;">
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;width:140px;">会社名</th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user.company.presence || "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;">お名前</th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user.name.presence || "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;">役職</th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user.job_title.presence || "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;">メール</th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user.email.presence || "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;">電話番号</th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user.tel.presence || "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;">いまのご状況</th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @phase_label %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;">導入予定</th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user_progress.planned_introduction_date.presence || "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;">決め手</th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @user_progress.key_points_for_application.presence || "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;">見込み度</th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @grade_label %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;">満足度</th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @rating.present? ? "#{@rating} / 5" : "—" %></td>
  </tr>
  <tr>
    <th align="left" style="padding:6px 8px;border-bottom:1px solid #e2e8f0;">ご意見</th>
    <td style="padding:6px 8px;border-bottom:1px solid #e2e8f0;"><%= @feedback.presence || "—" %></td>
  </tr>
</table>

<% if @summary_lines.present? %>
  <div style="margin-top:20px;padding:14px 16px;background:#f8fafc;border-radius:8px;max-width:560px;">
    <p style="margin:0 0 8px;font-weight:700;">商談サマリー</p>
    <% @summary_lines.each do |line| %>
      <p style="margin:0 0 4px;font-size:14px;line-height:1.6;"><%= line %></p>
    <% end %>
  </div>
<% end %>

<% if @interest_topics.present? %>
  <p style="margin:16px 0 0;font-size:14px;"><strong>関心トピック：</strong><%= @interest_topics %></p>
<% end %>

<p style="margin-top:24px;">
  <a href="<%= @dashboard_url %>" style="display:inline-block;padding:12px 18px;background:#2563eb;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:700;">ダッシュボードでリード詳細を見る</a>
</p>
<p style="margin:8px 0 0;font-size:12px;color:#64748b;word-break:break-all;"><%= @dashboard_url %></p>
