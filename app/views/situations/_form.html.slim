= form_with model: @situation, local: true do |f|
  .field
    = f.label :title, t("meetia.situations.title")
    = f.text_field :title

  .field
    = f.label :description, t("meetia.situations.description")
    = f.text_area :description

  .field
    = f.label :language, t("meetia.situations.language")
    = f.select :language, options_for_select([['English', 'en'], [t("meetia.interview.language_ja"), 'ja']], @situation.language), {}, class: 'form-control'

  .field
    = f.label :archived, t("meetia.situations.archived")
    = f.check_box :archived

  .actions
    = f.submit t("meetia.dashboard.common.save")
