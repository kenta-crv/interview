<%= t("meetia.owner_mail.completed_intro") %>

<%= t("meetia.owner_mail.deal") %>: <%= @deal.title %>

<%= t("meetia.dashboard.visitor_fields.company") %>: <%= @user.company.presence || "—" %>
<%= t("meetia.dashboard.visitor_fields.name") %>: <%= @user.name.presence || "—" %>
<%= t("meetia.dashboard.visitor_fields.job_title") %>: <%= @user.job_title.presence || "—" %>
<%= t("meetia.dashboard.visitor_fields.email") %>: <%= @user.email.presence || "—" %>
<%= t("meetia.dashboard.visitor_fields.tel") %>: <%= @user.tel.presence || "—" %>
<%= t("meetia.dashboard.visitor_fields.consideration_phase") %>: <%= @phase_label %>
<%= t("meetia.dashboard.visitor_fields.planned_introduction_date") %>: <%= @user_progress.planned_introduction_date.presence || "—" %>
<%= t("meetia.dashboard.visitor_fields.key_points_for_application") %>: <%= @user_progress.key_points_for_application.presence || "—" %>
<%= t("meetia.owner_mail.grade") %>: <%= @grade_label %>
<%= t("meetia.owner_mail.rating") %>: <%= @rating.present? ? "#{@rating} / 5" : "—" %>
<%= t("meetia.owner_mail.feedback") %>: <%= @feedback.presence || "—" %>
<% if @summary_lines.present? %>

<%= t("meetia.owner_mail.summary_title") %>
<%= @summary_lines.join("\n") %>
<% end %>
<% if @interest_topics.present? %>

<%= t("meetia.owner_mail.topics") %>: <%= @interest_topics %>
<% end %>

<%= t("meetia.owner_mail.dashboard_cta") %>: <%= @dashboard_url %>
