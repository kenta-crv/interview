<div class="meetia-auth__page">
  <%= link_to root_path, class: "meetia-auth__brand" do %>
    <%= image_tag "meetia_logo.png", alt: "Meetia", class: "meetia-auth__logo" %>
  <% end %>

  <div class="meetia-auth__card">
    <h1 class="meetia-auth__title"><%= t("meetia.auth.password_forgot_title") %></h1>
    <p class="meetia-auth__lead"><%= t("meetia.auth.password_forgot_lead") %></p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>

      <div class="meetia-auth__field">
        <%= f.label :email, t("meetia.auth.email"), class: "meetia-auth__label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "meetia-auth__input" %>
      </div>

      <%= f.submit t("meetia.auth.submit_password_email"), class: "meetia-btn meetia-btn--primary meetia-btn--lg meetia-auth__submit" %>
    <% end %>
  </div>

  <div class="meetia-auth__links">
    <%= render "users/shared/links" %>
  </div>
</div>
