.db-v2-header
  .db-v2-header__left
    h1.db-v2-header__title = t("meetia.dashboard.home.greeting", name: @display_name)
    p.db-v2-header__subtitle = t("meetia.dashboard.home.subtitle")
  .db-v2-header__right
    = render "/dashboard/theme_switch"

- a = @analytics

.db-v2-summary-grid
  .db-v2-summary-card
    .db-v2-summary-card__icon-wrap.db-v2-summary-card__icon-wrap--blue
      i.fa-solid.fa-link aria-hidden="true"
    .db-v2-summary-card__content
      .db-v2-summary-card__label = t("meetia.dashboard.home.metric_page_views")
      .db-v2-summary-card__value-row
        span.db-v2-summary-card__value = a[:page_views]
      .db-v2-summary-card__trend
        span.db-v2-summary-card__trend-label = t("meetia.dashboard.home.metric_page_views_hint")

  .db-v2-summary-card
    .db-v2-summary-card__icon-wrap.db-v2-summary-card__icon-wrap--gold
      i.fa-solid.fa-user-plus aria-hidden="true"
    .db-v2-summary-card__content
      .db-v2-summary-card__label = t("meetia.dashboard.home.metric_leads")
      .db-v2-summary-card__value-row
        span.db-v2-summary-card__value = a[:leads_count]
      .db-v2-summary-card__trend
        span.db-v2-summary-card__trend-label
          - if a[:lead_rate]
            = t("meetia.dashboard.home.metric_lead_rate", rate: a[:lead_rate])
          - else
            = t("meetia.dashboard.home.metric_leads_hint")

  .db-v2-summary-card
    .db-v2-summary-card__icon-wrap.db-v2-summary-card__icon-wrap--green
      i.fa-solid.fa-play aria-hidden="true"
    .db-v2-summary-card__content
      .db-v2-summary-card__label = t("meetia.dashboard.home.metric_sessions_started")
      .db-v2-summary-card__value-row
        span.db-v2-summary-card__value = a[:sessions_started]
      .db-v2-summary-card__trend
        span.db-v2-summary-card__trend-label
          - if a[:start_rate]
            = t("meetia.dashboard.home.metric_start_rate", rate: a[:start_rate])
          - else
            = t("meetia.dashboard.home.metric_sessions_started_hint")

  .db-v2-summary-card
    .db-v2-summary-card__icon-wrap.db-v2-summary-card__icon-wrap--purple
      i.fa-solid.fa-flag-checkered aria-hidden="true"
    .db-v2-summary-card__content
      .db-v2-summary-card__label = t("meetia.dashboard.home.metric_sessions_completed")
      .db-v2-summary-card__value-row
        span.db-v2-summary-card__value = a[:sessions_completed]
      .db-v2-summary-card__trend
        span.db-v2-summary-card__trend-label
          - if a[:completion_rate]
            = t("meetia.dashboard.home.metric_completion_rate", rate: a[:completion_rate])
          - else
            = t("meetia.dashboard.home.metric_sessions_completed_hint")

  .db-v2-summary-card
    .db-v2-summary-card__icon-wrap.db-v2-summary-card__icon-wrap--gold
      i.fa-solid.fa-star aria-hidden="true"
    .db-v2-summary-card__content
      .db-v2-summary-card__label = t("meetia.dashboard.home.metric_avg_rating")
      .db-v2-summary-card__value-row
        span.db-v2-summary-card__value = a[:average_evaluation] || "—"
        - if a[:average_evaluation]
          span.db-v2-summary-card__unit
            | / 5
      .db-v2-summary-card__trend
        span.db-v2-summary-card__trend-label = t("meetia.dashboard.home.metric_rating_count", count: a[:evaluation_count])

  .db-v2-summary-card.db-v2-summary-card--span-3.db-v2-summary-card--funnel
    .db-v2-summary-card__content.db-v2-summary-card__content--funnel
      .db-v2-summary-card__label = t("meetia.dashboard.home.metric_funnel")
      - segments = a[:funnel_segments]
      - if segments.present?
        .db-v2-funnel-pie
          .db-v2-funnel-pie__chart style="background: #{funnel_pie_gradient(segments)};"
            .db-v2-funnel-pie__inner
              .db-v2-funnel-pie__center
                span.db-v2-funnel-pie__prefix = funnel_pie_center_label(a)
                span.db-v2-funnel-pie__number = funnel_pie_center_value(a)
          .db-v2-funnel-pie__legends
            - segments.each do |seg|
              .db-v2-funnel-pie__legend
                span.db-v2-funnel-pie__badge style="background: #{seg[:color]};"
                .db-v2-funnel-pie__legend-body
                  span.db-v2-funnel-pie__legend-label = seg[:label]
                  span.db-v2-funnel-pie__legend-meta = t("meetia.dashboard.home.funnel_count", count: seg[:count], share: seg[:share])
            .db-v2-funnel-pie__rates
              - lead_label = t("meetia.dashboard.home.lead_rate_label")
              - start_label = t("meetia.dashboard.home.start_rate_label")
              - completion_label = t("meetia.dashboard.home.completion_rate_label")
              span = a[:lead_rate] ? t("meetia.dashboard.home.rate_with_value", label: lead_label, rate: a[:lead_rate]) : t("meetia.dashboard.home.rate_empty", label: lead_label)
              span = a[:start_rate] ? t("meetia.dashboard.home.rate_with_value", label: start_label, rate: a[:start_rate]) : t("meetia.dashboard.home.rate_empty", label: start_label)
              span = a[:completion_rate] ? t("meetia.dashboard.home.rate_with_value", label: completion_label, rate: a[:completion_rate]) : t("meetia.dashboard.home.rate_empty", label: completion_label)
      - else
        p.db-v2-muted style="margin:8px 0 0;" = t("meetia.dashboard.home.funnel_empty")

.db-v2-summary-grid
  .db-v2-summary-card
    .db-v2-summary-card__content
      .db-v2-summary-card__label = t("meetia.dashboard.home.high_prospects")
      .db-v2-summary-card__value-row
        span.db-v2-summary-card__value = a[:high_prospect_count]
      .db-v2-summary-card__trend
        span.db-v2-summary-card__trend-label
          - %w[A B C D].each do |grade|
            | #{grade}:#{a[:prospect_grade_counts][grade].to_i}
            |  

  .db-v2-summary-card
    .db-v2-summary-card__content
      .db-v2-summary-card__label = t("meetia.dashboard.home.cta_clicks")
      .db-v2-summary-card__value-row
        span.db-v2-summary-card__value = a[:cta_clicks]
      .db-v2-summary-card__trend
        span.db-v2-summary-card__trend-label = t("meetia.dashboard.home.cta_hint")

  .db-v2-summary-card
    .db-v2-summary-card__content
      .db-v2-summary-card__label = t("meetia.dashboard.home.follow_up")
      .db-v2-summary-card__value-row
        span.db-v2-summary-card__value = "#{a[:follow_up_opened]} / #{a[:follow_up_clicked]}"
      .db-v2-summary-card__trend
        span.db-v2-summary-card__trend-label = t("meetia.dashboard.home.follow_up_sent", count: a[:follow_up_sent])

  .db-v2-summary-card
    .db-v2-summary-card__content
      .db-v2-summary-card__label = t("meetia.dashboard.home.avg_duration")
      .db-v2-summary-card__value-row
        span.db-v2-summary-card__value = a[:average_duration_label]
      .db-v2-summary-card__trend
        span.db-v2-summary-card__trend-label = t("meetia.dashboard.home.avg_duration_hint")

- if a[:drop_offs].any?
  .db-v2-bottom-card
    .db-v2-bottom-card__header
      h2.db-v2-bottom-card__title = t("meetia.dashboard.home.drop_offs_title")
      p.db-v2-muted style="margin:0;" = t("meetia.dashboard.home.drop_offs_lead")
    .db-v2-bottom-card__body
      .db-v2-leads-table-wrap
        table.db-v2-leads-table
          thead
            tr
              th = t("meetia.dashboard.home.col_page")
              th = t("meetia.dashboard.home.col_title")
              th = t("meetia.dashboard.home.col_dropoffs")
              th = t("meetia.dashboard.home.col_share")
          tbody
            - a[:drop_offs].first(8).each do |row|
              tr
                td = "P.#{row[:page_number]}"
                td = row[:title]
                td = row[:count]
                td = "#{row[:share]}%"

#deals-hub.db-v2-bottom-card.db-v2-deals-hub
  .db-v2-bottom-card__header.db-v2-deals-hub__header
    .db-v2-deals-hub__heading
      h2.db-v2-bottom-card__title = t("meetia.dashboard.home.deals_hub_title")
    - if client_signed_in?
      = link_to new_dashboard_deal_path, class: "db-v2-btn db-v2-btn--primary db-v2-btn--xs" do
        i.fa-solid.fa-plus aria-hidden="true"
        span = t("meetia.dashboard.home.new")
  .db-v2-bottom-card__body
    - if @deals.empty?
      .db-v2-empty-state
        .db-v2-empty-state__icon
          i.fa-solid.fa-briefcase aria-hidden="true"
        p.db-v2-empty-state__text = t("meetia.dashboard.home.empty_deals")
        - if client_signed_in?
          = link_to new_dashboard_deal_path, class: "db-v2-btn db-v2-btn--primary" do
            i.fa-solid.fa-plus aria-hidden="true"
            span = t("meetia.dashboard.home.create_deal")
    - else
      - if @recent_deals.any?
        .db-v2-deal-quick-grid
          - @recent_deals.each do |deal|
            = link_to dashboard_deal_path(deal), class: "db-v2-deal-quick-card" do
              .db-v2-deal-quick-card__top
                span.db-v2-deal-quick-card__title = truncate(deal.title, length: 28)
                - if deal.playback_ready?
                  span.db-v2-status-badge.db-v2-status-badge--live = t("meetia.dashboard.status.live")
                - elsif deal.processing?
                  span.db-v2-status-badge.db-v2-status-badge--progress = t("meetia.dashboard.status.processing")
              span.db-v2-deal-quick-card__meta = l(deal.updated_at, format: :short)

      .db-v2-leads-table-wrap
        table.db-v2-leads-table.db-v2-deals-table
          thead
            tr
              th = t("meetia.dashboard.home.col_title")
              th = t("meetia.dashboard.home.col_status")
              th = t("meetia.dashboard.home.col_updated")
              th
          tbody
            - @deals.each do |deal|
              tr
                td.db-v2-deals-table__title = deal.title
                td
                  - if deal.playback_ready?
                    span.db-v2-status-badge.db-v2-status-badge--live = t("meetia.dashboard.status.live")
                  - elsif deal.processing?
                    span.db-v2-status-badge.db-v2-status-badge--progress = t("meetia.dashboard.status.processing")
                  - else
                    span.db-v2-status-badge = deal.status
                td = l(deal.updated_at, format: :short)
                td
                  = link_to t("meetia.dashboard.common.open"), dashboard_deal_path(deal), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--sm"

- if @recent_leads.any?
  .db-v2-bottom-card
    .db-v2-bottom-card__header
      h2.db-v2-bottom-card__title = t("meetia.dashboard.home.recent_leads")
    .db-v2-bottom-card__body
      .db-v2-leads-table-wrap
        table.db-v2-leads-table
          thead
            tr
              th = t("meetia.dashboard.home.col_name")
              th = t("meetia.dashboard.home.col_deal")
              th = t("meetia.dashboard.home.col_updated")
          tbody
            - @recent_leads.each do |lead|
              tr
                td = lead.user&.name.presence || lead.user&.email
                td = lead.deal&.title
                td = l(lead.updated_at, format: :short)
