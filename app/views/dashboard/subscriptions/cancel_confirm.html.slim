.db-v2-bottom-card
  .db-v2-bottom-card__header
    h2.db-v2-bottom-card__title = t("meetia.dashboard.subscription.cancel_confirm_title")
  .db-v2-bottom-card__body
    .db-v2-alert.db-v2-alert--info
      i.fa-solid.fa-circle-info aria-hidden="true"
      div
        p = t("meetia.dashboard.subscription.cancel_confirm_lead")
        p
          strong = t("meetia.dashboard.subscription.cancel_until", date: l(@available_until.to_date, format: :long))
        p.db-v2-checkout-alert-note = t("meetia.dashboard.subscription.cancel_until_note")

    .db-v2-subscription-status
      .db-v2-subscription-status__row
        span.db-v2-subscription-status__label = t("meetia.dashboard.subscription.current_plan")
        span.db-v2-subscription-status__value = @target_client.current_plan_config[:name]

    .db-v2-checkout-form__actions
      = link_to dashboard_subscription_path(subscription_path_options), class: "db-v2-btn db-v2-btn--ghost" do
        span = t("meetia.dashboard.common.back")
      = button_to cancel_dashboard_subscription_path(subscription_path_options), method: :post, class: "db-v2-btn db-v2-btn--danger", data: { turbo_confirm: t("meetia.dashboard.subscription.cancel_confirm_dialog"), confirm: t("meetia.dashboard.subscription.cancel_confirm_dialog") } do
        span = t("meetia.dashboard.subscription.cancel_confirm_btn")
