- plan = client_signed_in? ? current_client.current_plan_config : nil
- deal_limit = client_signed_in? ? current_client.deal_limit : nil

.db-v2-header
  .db-v2-header__left
    h1.db-v2-header__title = t("meetia.dashboard.deals.index_title")
    p.db-v2-header__subtitle
      - if acting_as_admin?
        = t("meetia.dashboard.deals.index_subtitle_admin")
      - elsif deal_limit
        = t("meetia.dashboard.deals.index_subtitle_limited", plan: plan[:name], used: current_client.deals_count, limit: deal_limit)
      - else
        = t("meetia.dashboard.deals.index_subtitle_unlimited", plan: plan[:name], used: current_client.deals_count)
  .db-v2-header__right
    = render "/dashboard/theme_switch"
    - if client_signed_in? || acting_as_admin?
      = link_to new_dashboard_deal_path, class: "db-v2-btn db-v2-btn--primary" do
        i.fa-solid.fa-plus aria-hidden="true"
        span = acting_as_admin? && !client_signed_in? ? t("meetia.dashboard.deals.create_admin") : t("meetia.dashboard.deals.create")

.db-v2-bottom-card
  .db-v2-bottom-card__header.db-v2-bottom-card__header--split
    h2.db-v2-bottom-card__title = t("meetia.dashboard.deals.list_title")
    span.db-v2-deals-count = t("meetia.dashboard.common.count", count: @deals.size)

  .db-v2-bottom-card__body
    - if @deals.empty?
      .db-v2-empty-state
        .db-v2-empty-state__icon
          i.fa-solid.fa-briefcase aria-hidden="true"
        p.db-v2-empty-state__text = t("meetia.dashboard.deals.empty")
        - if client_signed_in? || acting_as_admin?
          = link_to new_dashboard_deal_path, class: "db-v2-btn db-v2-btn--primary" do
            i.fa-solid.fa-plus aria-hidden="true"
            span = acting_as_admin? && !client_signed_in? ? t("meetia.dashboard.deals.create_admin_short") : t("meetia.dashboard.deals.create_first")
    - else
      .db-v2-leads-table-wrap
        table.db-v2-leads-table.db-v2-deals-table
          thead
            tr
              th = t("meetia.dashboard.deals.col_id")
              th = t("meetia.dashboard.deals.col_title")
              - if acting_as_admin?
                th = t("meetia.dashboard.deals.col_managed")
              th = t("meetia.dashboard.deals.col_status")
              th = t("meetia.dashboard.deals.col_language")
              th = t("meetia.dashboard.deals.col_docs")
              th = t("meetia.dashboard.deals.col_published")
              th = t("meetia.dashboard.deals.col_created")
              th = t("meetia.dashboard.deals.col_actions")
          tbody
            - @deals.each do |deal|
              tr
                td.db-v2-deals-table__id = deal.id
                td.db-v2-deals-table__title
                  = link_to deal.title, dashboard_deal_path(deal), class: "db-v2-deals-table__link"
                - if acting_as_admin?
                  td
                    - if deal.managed_by_admin?
                      span.db-v2-status-badge.db-v2-status-badge--live Admin
                    - else
                      span.db-v2-status-badge Client
                td
                  - case deal.status
                  - when "uploading", "processing", "transcribing", "summarizing"
                    span.db-v2-status-badge.db-v2-status-badge--progress = t("meetia.dashboard.status.processing")
                  - when "completed"
                    - if deal.playback_ready?
                      span.db-v2-status-badge.db-v2-status-badge--live = t("meetia.dashboard.status.live")
                    - else
                      span.db-v2-status-badge.db-v2-status-badge--ready = t("meetia.dashboard.status.ready")
                  - when "failed"
                    span.db-v2-status-badge.db-v2-status-badge--fail = t("meetia.dashboard.status.failed")
                  - else
                    span.db-v2-status-badge = deal.status
                td= deal.language.upcase
                td= deal.deal_documents.count
                td
                  - if deal.playback_ready?
                    i.fa-solid.fa-circle-check.db-v2-deals-table__ok aria-hidden="true"
                  - else
                    span.db-v2-deals-table__muted —
                td= l(deal.created_at, format: :short)
                td
                  .db-v2-deals-table__actions
                    = link_to dashboard_deal_path(deal), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs" do
                      span = t("meetia.dashboard.common.detail")
                    = link_to presentation_dashboard_deal_path(deal), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs", target: "_blank", rel: "noopener", data: { turbo: false } do
                      span = t("meetia.dashboard.deals.action_presentation")
                    - if deal.access_token.present?
                      = link_to public_deal_session_path(deal.access_token), class: "db-v2-btn db-v2-btn--ghost db-v2-btn--xs", target: "_blank", rel: "noopener" do
                        span = t("meetia.dashboard.deals.action_share")
                    = button_to dashboard_deal_path(deal), method: :delete, class: "db-v2-btn db-v2-btn--danger db-v2-btn--xs", form: { class: "db-v2-inline-form" }, data: { turbo_confirm: t("meetia.dashboard.deals.delete_confirm"), confirm: t("meetia.dashboard.deals.delete_confirm") } do
                      span = t("meetia.dashboard.common.delete")
